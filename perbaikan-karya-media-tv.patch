+        assert str(GroupTitle.parse("Undefined")) == DEFAULT_GROUP
+        assert str(GroupTitle.parse("General")) == DEFAULT_GROUP
+        assert str(GroupTitle.parse("undefined")) == DEFAULT_GROUP
+
+    def test_preserves_meaningful_multi_segment_title(self):
+        assert (

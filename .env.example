# Copy this file to .env and fill in real values.
# All variables are prefixed with IPTV_ (see settings.py's env_prefix).

IPTV_ENVIRONMENT=development
IPTV_LOG_LEVEL=INFO

# --- GitHub publishing ---
# Repository in "owner/repo" form, e.g. "budi/iptv-repo"
IPTV_GITHUB_REPOSITORY=
IPTV_GITHUB_BRANCH=main
# raw_only | pages_only | both
IPTV_PUBLISH_TARGET=both

# --- EPG ---
# Public XMLTV URL written into master.m3u's "#EXTM3U url-tvg=..." header
# so players auto-load a program guide. Leave unset to omit it.
IPTV_EPG_URL=https://epgshare01.online/epgshare01/epg_ripper_ALL_SOURCES1.xml.gz

# --- Validation tuning ---
IPTV_VALIDATION_TIMEOUT_SECONDS=10
IPTV_VALIDATION_MAX_CONCURRENCY=50
IPTV_VALIDATION_RETRIES=1

# --- FFprobe ---
IPTV_FFPROBE_BINARY=ffprobe
IPTV_FFPROBE_TIMEOUT_SECONDS=15

# --- Persistence (pipeline run history) ---
# If unset, defaults to a SQLite file under data/iptv.db
IPTV_DATABASE_URL=

# --- REST API & dashboard (self-hosted deployments only) ---
IPTV_API_HOST=0.0.0.0
IPTV_API_PORT=8000
# Required to POST /api/pipeline/run (trigger a manual run).
IPTV_API_KEY=
# Optional: protect the read-only dashboard with HTTP Basic Auth.
# Leave both blank to keep the dashboard open.
IPTV_DASHBOARD_USERNAME=
IPTV_DASHBOARD_PASSWORD=

# --- Background scheduler (self-hosted only; GitHub Actions doesn't need this) ---
IPTV_SCHEDULER_ENABLED=false
IPTV_SCHEDULER_INTERVAL_MINUTES=360
